PORT=5000
NODE_ENV=production

# ── MySQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=abhyo_lms
DB_USER=abhyo_dbuser
DB_PASS=your_db_password

# ── JWT Secrets ────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_2026
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_2026
JWT_REFRESH_EXPIRE=30d

# ── Razorpay (Live or Test) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Twilio SMS (optional) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (SMTP) ────────────────────────────────────────────
EMAIL_HOST=mail.abhyo.com
EMAIL_PORT=587
EMAIL_USER=support@abhyo.com
EMAIL_PASS=your_email_password
EMAIL_FROM=Abhyo <support@abhyo.com>
EMAIL_SECURE=false

# ── Frontend Domain (CORS) ──────────────────────────────────
CLIENT_URL=https://abhyo.com,https://www.abhyo.com

# ── File Upload ─────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
